# Database (Neon PostgreSQL or Local PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/daily_task_manager?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"
SERVER_URL="http://localhost:5000"

# CORS
CLIENT_URL="http://localhost:5173"

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Use a Gmail App Password (NOT your normal Gmail password).
# Generate at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── AI Provider (Google Gemini) ───────────────────────────────────────────────
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Object Storage (Cloudinary - Production Image Storage) ────────────────────
# Get your free Cloudinary credentials from: https://cloudinary.com/
# If unconfigured, falls back gracefully to local uploads/ directory for dev
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# If unconfigured, auto-generates dev keys on server start
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@taskflow.app
