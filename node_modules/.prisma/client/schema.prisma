generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks       Task[]
  categories  Category[]
  taskHistory TaskHistory[]

  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@map("categories")
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  dueTime     String?
  categoryId  String?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reminders     Reminder[]
  recurringTask RecurringTask?
  taskHistory   TaskHistory[]

  @@map("tasks")
}

model Reminder {
  id           String   @id @default(cuid())
  taskId       String
  reminderTime DateTime
  isSent       Boolean  @default(false)
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model RecurringTask {
  id                 String         @id @default(cuid())
  taskId             String         @unique
  recurrenceType     RecurrenceType
  recurrenceInterval Int            @default(1)
  endDate            DateTime?
  createdAt          DateTime       @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("recurring_tasks")
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_history")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceType {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  CUSTOM
}

model OtpVerification {
  id        String     @id @default(cuid())
  email     String
  otpHash   String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("otp_verifications")
}

enum OtpPurpose {
  LOGIN
  REGISTER
  PASSWORD_RESET
}
